{
  "name": "antigravity-office",
  "productName": "Antigravity Office",
  "version": "1.3.0",
  "description": "Pixel art virtual office visualization for Google Antigravity agents",
  "author": "W17ANT <https://github.com/W17ant>",
  "contributors": [
    {
      "name": "W17ANT",
      "url": "https://github.com/W17ant",
      "role": "Original creator (Claude-Office)"
    },
    {
      "name": "Ammar Sufyan",
      "url": "https://github.com/ammarsufyan",
      "role": "Antigravity Office adaptation & Windows support"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ammarsufyan/Antigravity-Office.git"
  },
  "homepage": "https://github.com/ammarsufyan/Antigravity-Office",
  "bugs": "https://github.com/ammarsufyan/Antigravity-Office/issues",
  "type": "module",
  "bin": {
    "antigravity-office": "cli/agent-office.mjs",
    "agent-office": "cli/agent-office.mjs"
  },
  "files": [
    "cli/",
    "server/",
    "shared/",
    "locales/",
    "dist/",
    "hooks/",
    "plugin.json",
    "hooks.json",
    "scripts/open-office.mjs",
    "scripts/doctor.mjs",
    "scripts/install-tool-hooks.mjs",
    "scripts/chat-ai-watcher.mjs",
    "electron/helpers.cjs",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"sleep 2 && electron .\"",
    "dev:all": "concurrently \"node server/index.js\" \"vite\"",
    "build": "tsc && vite build",
    "build:electron": "vite build && electron-builder",
    "pack": "vite build && electron-builder --dir",
    "electron": "electron .",
    "start": "npm run dev:electron",
    "server": "node server/index.js",
    "lan": "node scripts/lan.mjs",
    "open": "node scripts/open-office.mjs",
    "rotate-token": "node scripts/rotate-token.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-assets": "node scripts/check-assets.mjs",
    "install-hooks": "node scripts/install-tool-hooks.mjs",
    "install-antigravity": "node scripts/install-tool-hooks.mjs",
    "uninstall-antigravity": "node scripts/install-tool-hooks.mjs --uninstall",
    "chat-watcher": "node scripts/chat-ai-watcher.mjs",
    "start:antigravity": "node cli/agent-office.mjs start",
    "uninstall-hooks": "node scripts/install-tool-hooks.mjs --uninstall",
    "doctor": "node scripts/doctor.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11",
    "express": "^4.19.2",
    "qrcode-terminal": "0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^8.2.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.3.1",
    "typescript": "^5.5.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.agentoffice.app",
    "productName": "Agent Office",
    "extraMetadata": {
      "name": "agent-office"
    },
    "artifactName": "Agent-Office-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "dist/**",
      "electron/**",
      "!electron/after-pack.cjs",
      "server/**",
      "shared/**",
      "locales/**",
      "scripts/notify.sh"
    ],
    "npmRebuild": false,
    "afterPack": "electron/after-pack.cjs",
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  }
}
